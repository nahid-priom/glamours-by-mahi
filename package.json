{
  "name": "advanced-order-management-systems",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build-integrity.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run src/components src/app/guards src/lib/permissions",
    "test:routes": "vitest run src/app/routes/routes.smoke.test.ts",
    "test:integration": "vitest run src/features/**/__tests__",
    "test:supabase": "npm run db:test:p0 && npm run db:test:rls && npm run db:test:acceptance",
    "test:rls": "npm run db:test:rls",
    "test:rpc": "npm run db:test:p0 && npm run db:test:acceptance",
    "db:test:erp": "node scripts/run-db-smoke.mjs supabase/tests/erp_scenarios_outcome.sql && node scripts/test-concurrent-transfer.mjs",
    "db:test:concurrent": "node scripts/test-concurrent-transfer.mjs",
    "db:test:acceptance": "npx supabase db query --local \"SELECT public.run_erp_acceptance_report() AS report;\"",
    "db:test:recon": "node scripts/run-db-smoke.mjs supabase/tests/production_reconciliation.sql",
    "db:test:rls": "node scripts/run-db-smoke.mjs supabase/tests/rls/rls_matrix_smoke.sql",
    "db:test:p0": "node scripts/run-db-smoke.mjs supabase/tests/rpc/p0_delivery_smoke.sql supabase/tests/rpc/exchange_and_reset_contract_smoke.sql supabase/tests/rpc/data_reset_rpc_outcome_smoke.sql supabase/tests/rpc/bulk_import_smoke.sql supabase/tests/rpc/public_security_and_atomicity_smoke.sql supabase/tests/sql/inventory_wac_outcome_smoke.sql supabase/tests/sql/mod_reference_uniqueness_smoke.sql supabase/tests/sql/commission_structure_smoke.sql",
    "db:test:p0:linked": "node scripts/run-db-smoke.mjs --linked supabase/tests/rpc/p0_delivery_smoke.sql supabase/tests/rpc/exchange_and_reset_contract_smoke.sql supabase/tests/rpc/data_reset_rpc_outcome_smoke.sql supabase/tests/rpc/bulk_import_smoke.sql supabase/tests/sql/inventory_wac_outcome_smoke.sql supabase/tests/sql/mod_reference_uniqueness_smoke.sql supabase/tests/sql/commission_structure_smoke.sql",
    "db:test:reset": "node scripts/run-db-smoke.mjs supabase/tests/rpc/data_reset_rpc_outcome_smoke.sql",
    "db:types:linked": "powershell -ExecutionPolicy Bypass -File scripts/gen-types-linked.ps1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:edge": "node scripts/test-edge-smoke.mjs",
    "test:edge:deno": "deno test --allow-env --allow-net --allow-read supabase/functions/_tests",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "preview": "vite preview",
    "verify:build": "node scripts/verify-build-integrity.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "seed:sales-demo": "node scripts/seed-sales-demo.mjs",
    "seed:legacy-demo": "node scripts/seed-legacy-multibranch-demo.mjs",
    "verify:legacy-demo": "node scripts/verify-legacy-multibranch-demo.mjs",
    "cleanup:legacy-demo": "node scripts/cleanup-legacy-multibranch-demo.mjs",
    "verify:unified-core": "powershell -ExecutionPolicy Bypass -File scripts/verify-unified-core.ps1",
    "db:reset": "npx supabase db reset --yes",
    "db:types": "npx supabase gen types typescript --local -o src/types/database.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
