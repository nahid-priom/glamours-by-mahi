{
  "name": "advanced-order-management-systems",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "vitest run",
    "test:routes": "vitest run src/app/routes/routes.smoke.test.ts",
    "db:test:erp": "npx supabase db query --linked --file supabase/tests/erp_scenarios_outcome.sql && node scripts/test-concurrent-transfer.mjs",
    "db:test:concurrent": "node scripts/test-concurrent-transfer.mjs",
    "db:test:acceptance": "npx supabase db query --linked \"SELECT public.run_erp_acceptance_report() AS report;\"",
    "db:test:recon": "npx supabase db query --linked --file supabase/tests/production_reconciliation.sql",
    "db:types:linked": "powershell -ExecutionPolicy Bypass -File scripts/gen-types-linked.ps1",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "seed:sales-demo": "node scripts/seed-sales-demo.mjs",
    "verify:unified-core": "powershell -ExecutionPolicy Bypass -File scripts/verify-unified-core.ps1",
    "db:reset": "npx supabase db reset --yes",
    "db:types": "npx supabase gen types typescript --local -o src/types/database.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
