# Public Vite env (safe to expose in the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_APP_TITLE=Glamorous Gallery By Mahi

# Remote DB push (npm run db:push) — keep ONLY in .env.local (gitignored)
# Session pooler URL from Supabase → Project Settings → Database
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
