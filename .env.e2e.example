# Copy to .env.e2e.local (gitignored). Never commit real passwords.

# Owner / Super Admin for authenticated E2E (aliases E2E_OWNER_* also work)
OWNER_EMAIL=your-owner@example.com
OWNER_PASSWORD=use-a-vault-or-local-secret

# App under test
E2E_BASE_URL=http://localhost:5173
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Must be a non-production id (e.g. staging-xxx, test-sandbox, qa-1).
# Production-like values are denylisted and block mutating tests.
TEST_ENVIRONMENT_ID=staging-isolated

# Isolated staging/test Postgres for SQL smoke + factories (V5.1).
# NEVER point this at the production project. DATABASE_URL alone is ignored for QA.
# TEST_DATABASE_URL=postgresql://postgres.<STAGING_REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Set true only on verified staging with TEST_DATABASE_URL to enable purchase/POS/stock mutations
ALLOW_MUTATING_E2E=false

# Optional: pre-seeded cashier (otherwise seed script creates TEST_RUN_ID-scoped cashier)
# CASHIER_EMAIL=
# CASHIER_PASSWORD=

# Optional stable run id (auto-generated if unset)
# TEST_RUN_ID=
